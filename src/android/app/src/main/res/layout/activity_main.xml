<?xml version="1.0" encoding="utf-8"?>
<!--
  ステータスバーとナビゲーションバーの下に隠れないよう、
  余白は MainActivity が WindowInsets から計算して入れる。
  targetSdk 35 以降は端から端まで描画するのが既定になり、
  padding を固定値にすると上部がアプリバーに隠れる。

  clipToPadding は既定の true のままにする。
  false にすると、スクロールした中身が余白の部分にも描かれ、
  ステータスバーの裏を文字が通り抜けてしまう。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 入力欄には labelFor で見出しを結び付ける (読み上げのため)。
             どれも自動入力の対象にならない設定値なので importantForAutofill を no にする。
             autofillHints="" は警告を黙らせるだけで、意図が伝わらない。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/device"
            android:text="@string/label_device" />

        <EditText
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:text="@string/heading_collect_types" />

        <CheckBox
            android:id="@+id/collect_app_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_collect_app_usage" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/app_usage_interval"
            android:text="@string/label_app_usage_interval" />

        <EditText
            android:id="@+id/app_usage_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/collect_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_collect_notification" />

        <CheckBox
            android:id="@+id/collect_media_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_collect_media_play" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/media_play_interval"
            android:text="@string/label_media_play_interval" />

        <EditText
            android:id="@+id/media_play_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/read_chrome_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_read_chrome_history" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/chrome_history_interval"
            android:text="@string/label_chrome_history_interval" />

        <EditText
            android:id="@+id/chrome_history_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/collect_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_collect_wifi" />

        <CheckBox
            android:id="@+id/collect_bluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_collect_bluetooth" />

        <CheckBox
            android:id="@+id/collect_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_collect_power" />

        <CheckBox
            android:id="@+id/capture_screenshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_capture_screenshots" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/screenshot_interval"
            android:text="@string/label_screenshot_interval" />

        <EditText
            android:id="@+id/screenshot_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/capture_on_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_capture_on_unlock" />

        <CheckBox
            android:id="@+id/record_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_record_location" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/location_interval"
            android:text="@string/label_location_interval" />

        <EditText
            android:id="@+id/location_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/location_accuracy"
            android:text="@string/label_location_accuracy" />

        <EditText
            android:id="@+id/location_accuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/high_accuracy_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_high_accuracy_mode" />

        <CheckBox
            android:id="@+id/record_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_record_audio" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/audio_interval"
            android:text="@string/label_audio_interval" />

        <EditText
            android:id="@+id/audio_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/audio_duration"
            android:text="@string/label_audio_duration" />

        <EditText
            android:id="@+id/audio_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/record_audio_while_screen_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_record_audio_while_screen_off" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/note_audio_after_reboot" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/export_interval"
            android:text="@string/label_export_interval" />

        <EditText
            android:id="@+id/export_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/note_event_no_interval" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/note_session_always" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_save" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_start" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_stop" />

        <Button
            android:id="@+id/export_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_export_now" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/permission_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/permission_storage" />

        <Button
            android:id="@+id/permission_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_usage" />

        <Button
            android:id="@+id/permission_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_notification" />

        <Button
            android:id="@+id/permission_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_accessibility" />

        <Button
            android:id="@+id/permission_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_location" />

        <Button
            android:id="@+id/permission_background_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_background_location" />

        <Button
            android:id="@+id/permission_microphone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_microphone" />

        <Button
            android:id="@+id/permission_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_battery" />
    </LinearLayout>
</ScrollView>
