<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      生ログの受け渡しに使う /sdcard/gkill_autolog へ書くために要る。
      Termux の autolog がそこを読んで gkill へ入れるので、
      アプリ専用領域では渡せない。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 常駐収集。dataSync は Android 15 で1日6時間の上限が入るため specialUse を使う。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 画面が消えている間も位置情報を記録するため。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!--
      定期的な録音のため。
      位置情報と違い「バックグラウンドでのマイク」に当たる権限は無いので、
      マイクつきの常駐はアプリが前に出ている間しか開始できない。
      端末の再起動からは開始できず、次にアプリを開いたときに始まる。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- アプリ利用状況。設定画面からの許可が要る。 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- バッテリー最適化の対象外にする。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wi-Fi の SSID。Android 10 以降は位置情報の許可が要る。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      GPX の記録。画面が消えている間も位置情報を取るために要る。
      通常の許可ダイアログでは出せず、設定画面から「常に許可」を選ぶ必要がある。
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Bluetooth 機器名。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- 他アプリの表示名 (app_label) を取るためのパッケージ可視性の宣言。
         Android 11 以降はこれが無いと getApplicationInfo が失敗し、
         アプリ利用・再生・通知の記録が黙ってパッケージ名に落ちる。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".AutologApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AutologService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="端末の操作ログを継続的に記録し、自分のgkillへ取り込むため" />
        </service>

        <!-- 通知の取得。MediaSession の取得にもこの権限が要る。 -->
        <service
            android:name=".collect.NotificationCollectorService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 前面アプリの補助的な把握。 -->
        <service
            android:name=".collect.AutologAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                  アプリを更新すると常駐サービスが止まったままになる。
                  更新完了時に自分だけへ届くこれを受けて開始し直す。
                -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Termux の取り込みスクリプトから書き出しをさせるための受け口。
          intent-filter は付けない。呼ぶ側にコンポーネント名を明示させる。
        -->
        <receiver
            android:name=".ExportReceiver"
            android:exported="true" />
    </application>
</manifest>
