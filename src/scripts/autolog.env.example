# gkill_autolog の設定
#
# このファイルを autolog.env という名前でコピーして値を埋める。
# autolog.env はパスワードのハッシュを含むので .gitignore 済み。
#
# 同じ名前の環境変数が設定されている場合はそちらが優先される
# （Go 側・スクリプト側とも同じ順）。
#
# 文字コードは UTF-8 (BOM 付き) にすること。
# BOM が無いと Windows PowerShell 5.1 が Shift_JIS として読み、
# 日本語コメントの直後の行が黙って読み落とされる。

# 生ログ・台帳・ログ・スクリーンショットの置き場所。
# 省略時は %LOCALAPPDATA%\gkill_autolog
#AUTOLOG_HOME=

# この端末の名前。gkill の端末名（gkill_server dvnf get のディレクトリ名）と揃える。
# 省略時はこの機械のホスト名。
# アンダースコアと空白は使えない（<名前>_<端末>_<日付> の区切りと衝突するため）。
#
# この値は Kyou の create_device やスクリーンショットのファイル名に刻まれ、
# **間違ったまま集めた分は後から直せない。** 例をそのまま使わず、
# 自分の端末名を書いてから # を外すこと。
#AUTOLOG_DEVICE=Laptop

# 端末利用 TimeIs のタイトル。省略時は「端末利用」。
# 端末ごとに呼び分けたいときに設定する。
#AUTOLOG_USAGE_TITLE=Windows利用

# スクリーンショットの置き場（フラット。省略時は $AUTOLOG_HOME\screenshots）。
# ここから先へ運ぶのは同期スクリプトの dvnf move の役目。
#AUTOLOG_SCREENSHOT_DIR=

# スクリーンショットの撮影間隔。省略時は 1h（毎時00分）。
# 1h / 30m / 15m のように書く。単位を書かなければ秒として読む。
# 撮影時刻はこの間隔で丸めるので、15m なら毎時00分・15分・30分・45分になる。
# 10s 〜 24h の範囲へ丸められる。撮らないようにするには
# autolog collect --no-screenshot を使う。
#AUTOLOG_SCREENSHOT_INTERVAL=1h

# 取り込み先の gkill。
# HTTPS で動いているのに http:// を指定すると
# 「Client sent an HTTP request to an HTTPS server.」で 400 になる。
GKILL_BASE_URL=https://127.0.0.1:9999

# 自己署名証明書のため TLS の検証を省くかどうか。
GKILL_INSECURE=true

# 端末別ユーザーへ書き分ける。
# 実際のユーザー名は 接頭辞 + 端末名（例: myuser_auto_Laptop）。
# 端末が増えても、その端末の AUTOLOG_DEVICE を書くだけでよい。
#
# 接頭辞は gkill のユーザー名に刻まれる。例をそのまま使わず、
# 自分のユーザー名に合わせて書いてから # を外すこと。
#GKILL_AUTO_USER_PREFIX=myuser_auto_

# 端末別ユーザー共通のパスワード（sha256 の16進64文字）。
# 平文は書かない。set_auto_password.ps1 で設定する。
GKILL_AUTO_PASSWORD_SHA256=

# 端末別ユーザーを使わず1つのユーザーへまとめる場合はこちらを使う。
#GKILL_USER=
#GKILL_PASSWORD_SHA256=

# 取り込み（Android からの JSONL）とスクリプトが対象にする端末名（カンマ区切り）。
# 省略時はこの端末（AUTOLOG_DEVICE）の分だけ。この端末は常に含まれる。
#AUTOLOG_ALLOWED_DEVICES=

# Chrome 拡張からの受信アドレス。127.0.0.1 のみに bind すること。
#AUTOLOG_INGEST_ADDR=127.0.0.1:19921
# 共有トークン。省略時は $AUTOLOG_HOME/ingest_token.txt に自動生成される。
#AUTOLOG_INGEST_TOKEN=

# ---- Linux でだけ使う設定 ----
#
# どれも既定は空で、空なら環境から手段を導く（何が動いているか、
# PATH に何があるか）。標準の手段で取れない環境のための逃げ道。
# 選ばれた手段は autolog collect の起動時にログへ1行出る。

# 前面ウィンドウを1行の JSON で出すコマンド。
# GNOME・KDE の Wayland には前面ウィンドウを取る標準の手段が無い。
# {"app_name":"...","app_display_name":"...","window_title":"...","pid":123}
#AUTOLOG_LINUX_WINDOW_COMMAND=

# 入力の観測手段。auto / evdev / x11 / none
# evdev には /dev/input を読む権限が要る (sudo usermod -aG input $USER)。
#AUTOLOG_LINUX_INPUT_METHOD=auto

# 使う /dev/input/event* をカンマ区切りで固定する。
#AUTOLOG_LINUX_INPUT_DEVICES=

# SSID を1行で出すコマンド。
#AUTOLOG_LINUX_SSID_COMMAND=

# 撮影の手段。auto / x11 / command / portal
#AUTOLOG_LINUX_SCREENSHOT_METHOD=auto

# 画面を撮って {} のパスへ書くコマンド。{} が無ければ標準出力から読む。
#AUTOLOG_LINUX_SCREENSHOT_COMMAND=
