# ---------------------------------------------------------------- 機密
# パスワードのハッシュを含む。雛形の autolog.env.example だけを追跡する。
autolog.env
# 共有トークン（通常は $AUTOLOG_HOME に作られるが、念のため）
ingest_token.txt
# APK の署名鍵。置き場はリポジトリの外だが、持ち込んでも追跡しない。
*.keystore
*.jks

# ---------------------------------------------------------------- ビルド成果物
*.exe
*.exe~
*.test
*.dll
*.so
*.dylib
# npm run build 系が出すビルド成果物。
# android/arm64 のバイナリは拡張子が無いのでディレクトリごと指定する。
/release/

# Go のローカルワークスペース。環境ごとに違うので共有しない。
go.work
go.work.sum

# ビルドに使う Node のパッケージ。package-lock.json は追跡する。
node_modules/

# ---------------------------------------------------------------- 実行時に作られるもの
# 生ログ・台帳・受け渡しの JSONL。
# 通常は $AUTOLOG_HOME（リポジトリ外）に作られるが、
# そこをリポジトリ内に向けても混入しないようにしておく。
*.db
*.db-journal
*.db-shm
*.db-wal
*.jsonl
work/
logs/
*.log
# 撮影した画像（通常は $AUTOLOG_HOME の下）。
screenshots/
# 録った音声と位置情報。
#
# 置き場は Android の共有ストレージ（/sdcard/gkill_autolog）でリポジトリの外だが、
# 切り分けのために手元へ持ち込むことがある。画像よりさらに踏み込んだ記録なので、
# 置き場ごとでもファイル単体でも追跡しない。
#
# 拡張子まで書くのは、置き場から出して名前を変えたものを拾うため。
# このリポジトリに .m4a と .gpx を追跡する理由は無い。
audio/
*.m4a
gpslog/
*.gpx

# ---------------------------------------------------------------- Android
/src/android/local.properties
/src/android/.gradle/
/src/android/.kotlin/
/src/android/.cxx/
/src/android/captures/
/src/android/**/build/
*.apk
*.aab
*.iml

# ---------------------------------------------------------------- エディタ・OS
.idea/
.vscode/
# .claude 直下は無視するが、リポジトリで共有する規約スキルだけ追跡する。
# （`.claude/` のディレクトリ除外形のままではネガティブパターンが効かない。
#   git はネガティブパターンで親ディレクトリの除外を打ち消せないため、skills が
#   CI や新しいクローンに存在せず、verify_docs の checkSkills が
#   「1つも見つからない」で落ちる。settings.local.json は無視のまま）
/.claude/*
!/.claude/skills/
.DS_Store
*.swp
*~
# Cygwin の bash が落ちたときに残すメモリダンプ。
*.stackdump

# 個人情報検査のローカル NG 語リスト（コミットしない。checkPersonalInfo が読む）
verify_docs_personal_ngwords.local.txt
