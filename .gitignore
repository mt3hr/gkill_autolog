# ---------------------------------------------------------------- 機密
# パスワードのハッシュを含む。雛形の autolog.env.example だけを追跡する。
autolog.env
# 共有トークン（通常は $AUTOLOG_HOME に作られるが、念のため）
ingest_token.txt
# APK の署名鍵。置き場はリポジトリの外だが、持ち込んでも追跡しない。
*.keystore
*.jks

# ---------------------------------------------------------------- ビルド成果物
*.exe
*.exe~
*.test
*.dll
*.so
*.dylib
# npm run build 系が出すビルド成果物。
# android/arm64 のバイナリは拡張子が無いのでディレクトリごと指定する。
/release/

# Go のローカルワークスペース。環境ごとに違うので共有しない。
go.work
go.work.sum

# ビルドに使う Node のパッケージ。package-lock.json は追跡する。
node_modules/

# ---------------------------------------------------------------- 実行時に作られるもの
# 生ログ・台帳・受け渡しの JSONL。
# 通常は $AUTOLOG_HOME（リポジトリ外）に作られるが、
# そこをリポジトリ内に向けても混入しないようにしておく。
*.db
*.db-journal
*.db-shm
*.db-wal
*.jsonl
work/
logs/
*.log
# 撮影した画像（通常は $AUTOLOG_HOME の下）。
screenshots/

# ---------------------------------------------------------------- Android
/src/android/local.properties
/src/android/.gradle/
/src/android/.kotlin/
/src/android/.cxx/
/src/android/captures/
/src/android/**/build/
*.apk
*.aab
*.iml

# ---------------------------------------------------------------- エディタ・OS
.idea/
.vscode/
.claude/
.DS_Store
*.swp
*~
# Cygwin の bash が落ちたときに残すメモリダンプ。
*.stackdump
