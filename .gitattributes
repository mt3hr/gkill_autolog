# 改行コードをリポジトリ側で決める。
#
# 各クローンの core.autocrlf に任せると、設定の違う環境から
# CRLF が混入して差分が出る。ここで固定して環境差をなくす。

# 既定: リポジトリには LF で保存し、チェックアウトも LF。
* text=auto eol=lf

# Windows でしか使わないものは CRLF で取り出す。
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix のシェルスクリプトは必ず LF。CRLF だと実行できない。
*.sh    text eol=lf
gradlew text eol=lf

# バイナリ。改行変換も差分表示もしない。
*.jar  binary
*.apk  binary
*.aab  binary
*.png  binary
*.webp binary
*.ico  binary
